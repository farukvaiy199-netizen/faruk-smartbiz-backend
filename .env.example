# সার্ভার পোর্ট
PORT=3000

# Facebook/WhatsApp webhook ভেরিফাই করার জন্য নিজে একটা যেকোনো গোপন শব্দ বসান
# Meta Developer Dashboard-এ webhook সেটআপ করার সময় এই একই শব্দ বসাতে হবে
WEBHOOK_VERIFY_TOKEN=amar_gopon_token_123

# ড্যাশবোর্ড থেকে /api/settings এ পাঠানো টোকেন/কী কে ডিস্কে সেভ করার আগে
# এনক্রিপ্ট করতে ব্যবহৃত হয় (যেকোনো লম্বা র‍্যান্ডম স্ট্রিং দিন)
SETTINGS_ENCRYPTION_KEY=change_this_to_a_long_random_string

# Facebook "অটো-কানেক্ট" বাটনের জন্য — Meta Developer Dashboard → App settings → Basic
# → App Secret (Show চাপলে দেখা যায়) থেকে কপি করুন। এটা কখনো ফ্রন্টএন্ডে যাবে না, শুধু এখানে।
FB_APP_SECRET=
